# Dockerfile for Zappa deployments on Python 3.11
# Uses full python:3.11 image (build tools already included)
# Usage: docker build -f Dockerfile.zappa -t zappa-deployer .

FROM python:3.11

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV="/opt/venv"

# Pin setuptools to avoid distutils breakage with Zappa 0.58.0
RUN pip install --no-cache-dir \
    setuptools==69.5.1 \
    awscrt \
    awscli \
    zappa==0.58.0 \
    boto3

WORKDIR /app
CMD ["python", "--version"]
